Algoritmo Triangulo
	Definir lado1, lado2, lado3 como Real
	Escribir "ingrese las medidas de cada lado"
	Escribir "ladoA"
	Leer lado1
	Escribir "ladoB"
	Leer lado2
	Escribir "ladoC"
	Leer lado3
	Si  (lado1+lado2>lado3) Y (lado1+lado3>lado2) Y (lado2+lado3>lado1) Entonces
		Escribir "puede formar un triangulo"
	SiNo
		Escribir "no puede formar un triangulo"
	FinSi
FinAlgoritmo
